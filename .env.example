# Copy this file to .env and fill in real values before running
# `docker compose up -d`. See docs/ENVIRONMENT.md for details on each
# variable. Never commit a filled-in .env file.

# --- Django -----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://music.example.com
DJANGO_TIME_ZONE=UTC
DJANGO_LANGUAGE_CODE=en
DJANGO_BEHIND_PROXY=true
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=spotdl_ui
POSTGRES_USER=spotdl_ui
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery -----------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=1800
# How long Redis waits after delivering a task before assuming the worker
# that received it died and redelivering it to another one — Celery's own
# default (3600s, one hour) means a container restarted mid-download can
# take up to an hour to actually resume, which reads as "never resumes" —
# see docs/TROUBLESHOOTING.md. Kept comfortably above a single download's
# realistic worst case so a still-legitimately-running one is never
# mistaken for abandoned.
CELERY_VISIBILITY_TIMEOUT_SECONDS=1800

# --- Music / spotDL -------------------------------------------------------
MUSIC_ROOT=/data/music
DOWNLOAD_TEMP_ROOT=/data/downloads
STATIC_ROOT=/data/static
MEDIA_ROOT=/data/media
# How the library's in-browser playback (apps/library/views.track_stream)
# hands the audio file to the browser. "nginx" (default, for the bundled
# docker-compose stack) uses X-Accel-Redirect and lets nginx's internal
# /protected-music/ location serve it, including HTTP Range support for
# seeking. Use "direct" only if there is no nginx in front of Django (e.g.
# a different reverse proxy, or `manage.py runserver` in local dev).
MUSIC_STREAMING_BACKEND=nginx
SPOTDL_EXECUTABLE=spotdl
SPOTDL_VERSION=4.5.2
SPOTDL_AUDIO_FORMAT=mp3
# One of spotDL's --bitrate choices (e.g. 128k, 320k, auto, disable), or
# empty to omit the flag and let spotDL use its own default. "disable"
# is spotDL's own way to remove the constraint entirely — it keeps the
# source's original bitrate instead of transcoding to a fixed one.
SPOTDL_BITRATE=320k
SPOTDL_OUTPUT_TEMPLATE={artist}/{album}/{track-number:02d} - {title}.{output-ext}
SPOTDL_CLIENT_ID=
SPOTDL_CLIENT_SECRET=
# Provider tiering: try the primary provider for the first N attempts,
# then fall back. Each attempt is a separate spotDL invocation (driven by
# the per-item retry loop), so this is how "try YouTube a few times, then
# try something else" actually happens — spotDL's own --audio fallback
# only tries each provider once per invocation, not several times before
# moving on. Empty primary means "let spotDL use its own default".
#
# These three are only the *bootstrap* values, used the first time
# SiteSettings is created and as a lower-level fallback for direct use of
# the spotDL service layer — the real, ongoing control is the admin
# "Site settings" page (/settings/), editable without a redeploy. See
# apps.downloader.tasks.pick_audio_providers().
SPOTDL_PRIMARY_AUDIO_PROVIDER=youtube-music
SPOTDL_PRIMARY_PROVIDER_ATTEMPTS=3
# Comma-separated; used once SPOTDL_PRIMARY_PROVIDER_ATTEMPTS is
# exhausted. Empty means no fallback tier at all (primary keeps retrying
# until SPOTDL_MAX_RETRIES).
SPOTDL_FALLBACK_AUDIO_PROVIDERS=soundcloud
# SOCKS5/HTTP proxy for spotDL's own network calls, e.g. socks5://host:port.
# Only needed if your deployment's outbound IP is itself rate-limited or
# blocked by the audio provider — see docs/TROUBLESHOOTING.md.
SPOTDL_PROXY=
# Total attempts per item = this + 1. Must exceed
# SPOTDL_PRIMARY_PROVIDER_ATTEMPTS for the fallback tier above to ever
# actually be reached.
SPOTDL_MAX_RETRIES=3
SPOTDL_DOWNLOAD_TIMEOUT=600
# Separate, larger timeout for resolving a source (looking up every track in a
# playlist/album before any download starts) — this scales with playlist size, not
# with a single track, so it needs more headroom than SPOTDL_DOWNLOAD_TIMEOUT above.
SPOTDL_RESOLVE_TIMEOUT=2400
DOWNLOAD_CONCURRENCY=2
MAX_TRACKS_PER_SOURCE=500

# --- MusicBrainz ------------------------------------------------------------
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT=spotdl-ui/0.1 ( admin@example.com )
MUSICBRAINZ_CONTACT=admin@example.com
MUSICBRAINZ_RATE_LIMIT=1.0
# How often Celery Beat checks whether it's a good time to run the background
# MusicBrainz sweep (apps.musicbrainz.tasks.musicbrainz_sweep_task) — each run
# still only processes SiteSettings.musicbrainz_sweep_batch_size tracks, and
# only when no download batch is currently active (see the admin guide).
MUSICBRAINZ_SWEEP_INTERVAL_SECONDS=300

# --- SMTP -------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=spotdl-ui@example.com

# --- Shared import links ----------------------------------------------------
SHARED_LINK_DEFAULT_TTL_HOURS=24
SHARED_LINK_MAX_TTL_HOURS=336
SHARED_LINK_MAX_USES=20
SHARED_LINK_MAX_ITEMS_PER_SUBMISSION=25
SHARED_LINK_CLEANUP_RETENTION_DAYS=30

# --- Scheduled cleanup ------------------------------------------------------
CLEANUP_INTERVAL_SECONDS=900

# --- Production security (enable once served over HTTPS) --------------------
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# --- PostgreSQL container (docker-compose only) ------------------------------
POSTGRES_INITDB_ARGS=
